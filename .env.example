# Copy this file to .env.local and fill in your own values.
# .env.local is git-ignored. Never commit real keys.

# PayPal sandbox REST app (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# Webhook ID shown after you add the webhook on the sandbox app
PAYPAL_WEBHOOK_ID=

# Which AI provider to try first (the other is the automatic backup)
AI_PROVIDER_ORDER=groq,gemini

# Google Gemini free tier (aistudio.google.com/apikey)
GOOGLE_GENERATIVE_AI_API_KEY=
# Use a model listed in Google AI Studio for your key
GEMINI_MODEL=gemini-3.8-flash

# Groq free tier (console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Default due terms for new invoices: DUE_ON_RECEIPT, NET_10, NET_15 or NET_30
DEFAULT_PAYMENT_TERM=NET_15

# Your home currency for the books and the tax statement (ISO code, e.g. ZAR, INR, PHP, KES)
LOCAL_CURRENCY=ZAR

# The business name clients see on your invoices (optional)
BUSINESS_NAME=
